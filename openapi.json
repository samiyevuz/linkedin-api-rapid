{
  "openapi": "3.1.0",
  "info": {
    "title": "LinkedIn Media API",
    "description": "Download videos and images from LinkedIn posts without authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://213.199.36.249:8002",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:8002",
      "description": "Local Development"
    }
  ],
  "paths": {
    "/api/v1/download": {
      "get": {
        "summary": "Download Linkedin Post",
        "description": "Extract media directly from a LinkedIn post URL anonymously.",
        "operationId": "download_linkedin_post_api_v1_download_get",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "LinkedIn post URL",
              "title": "Url"
            },
            "description": "LinkedIn post URL"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedinResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
